# ---- server ----
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/vorizon
# In production these MUST be strong (>= 32 chars) and not these dev defaults,
# or the server refuses to boot. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
CORS_ORIGIN=http://localhost:5173
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=15
# Max requests per IP per minute across the API (auth routes are stricter).
RATE_LIMIT_MAX=300

# ---- firebase (optional) ----
# When set, enables Firestore-backed rate limiting (shared across instances), a
# durable Firestore campaign queue, and raw upload storage. Leave blank to use
# in-memory fallbacks.
# FIREBASE_SERVICE_ACCOUNT accepts inline service-account JSON or a path to the
# key file (a GOOGLE_APPLICATION_CREDENTIALS path also works).
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT=
# Run the campaign worker inside the API process (true) or as dedicated
# `npm run worker` processes for horizontal scale (false).
WORKER_IN_PROCESS=true

# ---- voice engine ----
VOICE_PROVIDER=mock            # mock | retell
# Required when VOICE_PROVIDER=retell (see INTEGRATIONS.md):
RETELL_API_KEY=
RETELL_AGENT_ID=               # agent created in the Retell dashboard
RETELL_FROM_NUMBER=            # E.164 outbound caller ID owned in Retell
RETELL_VERIFY_WEBHOOK=true     # reject unsigned Retell webhooks

# ---- exotel voice (VOICE_PROVIDER=exotel) ----
# Native Exotel telephony: places outbound calls via the Connect API to a Call
# Flow that runs the Exotel Voicebot. The AI is configured in Exotel's Voicebot
# dashboard (no API). Requires a provisioned ExoPhone + Voicebot minutes + flow.
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SID=                    # Account SID, e.g. crowdbuzz1
EXOTEL_SUBDOMAIN=api.exotel.com   # or api.in.exotel.com (India cluster)
EXOTEL_CALLER_ID=             # an ExoPhone you own (E.164)
EXOTEL_FLOW_URL=              # App Bazaar flow URL running the Voicebot applet
EXOTEL_WEBHOOK_TOKEN=         # shared secret appended to the status-callback URL

# ---- interview LLM ----
# If unset, the interview endpoint runs in offline echo-mode (no external calls).
ANTHROPIC_API_KEY=
INTERVIEW_MODEL=claude-sonnet-5
# Fallback interview LLM when no Anthropic key is set:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- transactional email (Resend) ----
# Unset → emails are skipped (logged, never fail the calling flow).
RESEND_API_KEY=
# Must be a Resend-verified sender; onboarding@resend.dev works without a domain.
EMAIL_FROM=Vorizon <onboarding@resend.dev>
# Optional: where replies land (any address, e.g. your business gmail).
EMAIL_REPLY_TO=
# Base URL used for links inside emails.
APP_BASE_URL=http://localhost:5173

# ---- payments (Razorpay) ----
# Both unset → payment endpoints return 503. Never expose the secret client-side.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret of the webhook created in Dashboard → Settings → Webhooks.
RAZORPAY_WEBHOOK_SECRET=

# ---- billing ----
RATE_USD_PER_MINUTE=0.10
# INR→USD rate for crediting Razorpay payments into the USD wallet.
USD_INR_RATE=83

# ---- client (Vite) ----
VITE_API_BASE_URL=http://localhost:4000/api

# ---- integration layer (connectors + leads) ----
API_BASE_URL=              # public origin of THIS API (for OAuth redirects + lead intake URL)
INTEGRATIONS_ENCRYPTION_KEY=   # AES key for stored OAuth tokens; falls back to JWT_ACCESS_SECRET
# Connector OAuth app credentials (set per provider you enable):
# GOOGLE_CLIENT_ID= / GOOGLE_CLIENT_SECRET=  META_APP_ID= / META_APP_SECRET=
# HUBSPOT_CLIENT_ID= / HUBSPOT_CLIENT_SECRET=  (etc — see server/src/modules/integrations/catalog.ts)
