# ---- server ----
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/vorizon
# In production these MUST be strong (>= 32 chars) and not these dev defaults,
# or the server refuses to boot. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
CORS_ORIGIN=http://localhost:5173
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=15
# Max requests per IP per minute across the API (auth routes are stricter).
RATE_LIMIT_MAX=300

# ---- redis (optional) ----
# When set, enables Redis-backed rate limiting (shared across instances) and a
# durable BullMQ campaign queue. Leave blank to use in-memory fallbacks.
# Redis Cloud:   redis://default:<password>@<host>:<port>
# Upstash (TLS): rediss://default:<password>@<host>:6379
REDIS_URL=
# Run the campaign worker inside the API process (true) or as dedicated
# `npm run worker` processes for horizontal scale (false).
WORKER_IN_PROCESS=true

# ---- voice engine ----
VOICE_PROVIDER=mock            # mock | vapi (phase 2)

# ---- interview LLM ----
# If unset, the interview endpoint runs in offline echo-mode (no external calls).
ANTHROPIC_API_KEY=
INTERVIEW_MODEL=claude-sonnet-5

# ---- billing ----
RATE_USD_PER_MINUTE=0.10

# ---- client (Vite) ----
VITE_API_BASE_URL=http://localhost:4000/api
