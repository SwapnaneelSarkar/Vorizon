# Firebase web app config (Authentication → Google sign-in). Not a
# traditional secret — it's meant to ship in the client bundle — but is kept
# out of source so it isn't a literal match for secret scanners and can be
# rotated without a code change. Get these from:
#   firebase apps:sdkconfig WEB <APP_ID> --project <PROJECT_ID>
# or Firebase Console → Project settings → General → Your apps → Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
